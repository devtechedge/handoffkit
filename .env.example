# Postgres connection string. Required for accounts, packs and leads.
DATABASE_URL=

# Random 32+ byte string mixed into session token hashes. Required for accounts.
SESSION_PEPPER=

# Public canonical URL. Optional in local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lemon Squeezy. Leave blank to keep checkout disabled.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
